TARGET=alma10
DISTRO_NAME="AlmaLinux 10"
HOSTNAME=cis-alma10
EL_MAJOR=10
# Datastream name inferred from the almalinux9 pattern — verify with
# `oscap info` on first build of this target.
SSG_DS=ssg-almalinux10-ds.xml
INSTALL_SRC=cdrom
APPSTREAM_URL=https://repo.almalinux.org/almalinux/10/AppStream/x86_64/os/
ISO_URL=https://repo.almalinux.org/almalinux/10/isos/x86_64/AlmaLinux-10-latest-x86_64-minimal.iso
CHECKSUM_URL=https://repo.almalinux.org/almalinux/10/isos/x86_64/CHECKSUM
BASEOS_REPO="repo --name=BaseOS-net --baseurl=https://repo.almalinux.org/almalinux/10/BaseOS/x86_64/os/"
# FIPS 140 mode: yes appends fips=1 to the kernel cmdline. Not required by
# CIS L1 (the DISA STIG profiles are what require it).
FIPS=no
