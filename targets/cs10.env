TARGET=cs10
DISTRO_NAME="CentOS Stream 10"
HOSTNAME=cis-cs10
EL_MAJOR=10
SSG_DS=ssg-cs10-ds.xml
INSTALL_SRC="url --url=https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/os/"
APPSTREAM_URL=https://mirror.stream.centos.org/10-stream/AppStream/x86_64/os/
ISO_URL=https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/iso/CentOS-Stream-10-latest-x86_64-boot.iso
CHECKSUM_URL=https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/iso/CentOS-Stream-10-latest-x86_64-boot.iso.SHA256SUM
# CAVEAT: same Stream drift caveat as cs9.
BASEOS_REPO=""
# FIPS 140 mode: yes appends fips=1 to the kernel cmdline. Not required by
# CIS L1 (the DISA STIG profiles are what require it).
FIPS=no
