TARGET=ubuntu2404
DISTRO_NAME="Ubuntu Server 24.04 LTS"
HOSTNAME=cis-ubuntu2404
EL_MAJOR=
PROVISIONER=autoinstall
SSG_DS=ssg-ubuntu2404-ds.xml
# Ubuntu's profile id differs from EL's cis_server_l1.
CIS_PROFILE=xccdf_org.ssgproject.content_profile_cis_level1_server
INSTALL_SRC=
APPSTREAM_URL=
BASEOS_REPO=""
ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.4-live-server-amd64.iso
CHECKSUM_URL=https://releases.ubuntu.com/24.04/SHA256SUMS
# CIS Ubuntu Linux 24.04 LTS Benchmark v1.0.0 (2024-08-26) per SSG.
FIPS=no
SSG_SOURCE=staged
