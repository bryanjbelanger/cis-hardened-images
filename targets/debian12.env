TARGET=debian12
DISTRO_NAME="Debian 12 (bookworm)"
HOSTNAME=cis-debian12
EL_MAJOR=
# Third provisioner family: debian-installer + preseed. Unlike Anaconda (OEMDRV)
# and Subiquity (CIDATA), d-i does NOT discover its config by volume label — the
# preseed is embedded in a repacked ISO and named on the kernel command line.
PROVISIONER=preseed
SSG_DS=ssg-debian12-ds.xml
# Same profile id as Ubuntu, not EL's cis_server_l1.
# CIS Debian Linux 12 Benchmark v1.1.0 (2024-09-26) per SSG.
CIS_PROFILE=xccdf_org.ssgproject.content_profile_cis_level1_server
INSTALL_SRC=
APPSTREAM_URL=
BASEOS_REPO=""
ISO_URL=https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/debian-12.12.0-amd64-netinst.iso
CHECKSUM_URL=https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/SHA256SUMS
FIPS=no
# SSG_SOURCE=staged is MANDATORY here, not a preference. Debian 12 packages SSG
# 0.1.65 and the CIS Debian 12 content only appeared upstream in 0.1.78 —
# verified by bisecting the tags. Even trixie (0.1.76) predates it, so NO Debian
# release can supply this datastream. fetch-ssg.sh stages it from sid's
# ssg-debian 0.1.80 package.
SSG_SOURCE=staged
# No STIG variant: DISA publishes no Debian STIG, and ssg-debian12 carries only
# the CIS and ANSSI profiles. `build-packer.sh debian12 ... stig` would fail at
# the remediation step.
STIG_SUPPORTED=no
