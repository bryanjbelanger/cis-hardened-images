TARGET=rocky9
DISTRO_NAME="Rocky Linux 9"
HOSTNAME=cis-rocky9
EL_MAJOR=9
SSG_DS=ssg-rl9-ds.xml
INSTALL_SRC=cdrom
APPSTREAM_URL=https://dl.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/
ISO_URL=https://download.rockylinux.org/pub/rocky/9/isos/x86_64/Rocky-9-latest-x86_64-minimal.iso
CHECKSUM_URL=https://download.rockylinux.org/pub/rocky/9/isos/x86_64/CHECKSUM
BASEOS_REPO="repo --name=BaseOS-net --baseurl=https://dl.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/"
# FIPS 140 mode: yes appends fips=1 to the kernel cmdline. Not required by
# CIS L1 (the DISA STIG profiles are what require it).
FIPS=no
