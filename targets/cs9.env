TARGET=cs9
DISTRO_NAME="CentOS Stream 9"
HOSTNAME=cis-cs9
EL_MAJOR=9
SSG_DS=ssg-cs9-ds.xml
# Stream boot ISOs carry no packages: install from the BaseOS network repo.
INSTALL_SRC="url --url=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/"
APPSTREAM_URL=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/
ISO_URL=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/iso/CentOS-Stream-9-latest-x86_64-boot.iso
CHECKSUM_URL=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/iso/CentOS-Stream-9-latest-x86_64-boot.iso.SHA256SUM
# CAVEAT: CIS benchmarks target RHEL releases; Stream runs ahead of RHEL, so
# the SSG cis_server_l1 content may drift from the published benchmark.
BASEOS_REPO=""
# FIPS 140 mode: yes appends fips=1 to the kernel cmdline. Not required by
# CIS L1 (the DISA STIG profiles are what require it).
FIPS=no
# SSG profile id — EL uses cis_server_l1; Ubuntu uses cis_level1_server.
CIS_PROFILE=xccdf_org.ssgproject.content_profile_cis_server_l1
PROVISIONER=kickstart
